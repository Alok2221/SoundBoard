<Window x:Class="SoundboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SoundboardApp.Converters"
        Title="Soundboard"
        Height="760"
        Width="1180"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PadColorConverter x:Key="PadColor"/>

        <Style x:Key="PadCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2E3545"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SOUNDBOARD"
                           FontSize="28"
                           FontWeight="Bold"
                           FontFamily="Bahnschrift, Segoe UI"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Local sounds → buttons &amp; hotkeys → Discord voice"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add files"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding AddSoundsCommand}"/>
                <Button Content="Folder"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddFolderCommand}"/>
                <Button Content="Stop"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding StopAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Discord / devices panel -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="DISCORD OUTPUT (virtual cable)"
                               Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedDiscordDevice}"
                              DisplayMemberPath="Name"/>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="In Discord, set input to "/>
                        <Run Text="CABLE Output" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <Run Text=". Your real mic is selected below."/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="MONITOR (headphones / speakers)"
                               Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedMonitorDevice}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding EnableMonitor}"/>
                    <CheckBox Content="Also play locally (monitor)"
                              IsChecked="{Binding EnableMonitor}"
                              Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <DockPanel>
                        <TextBlock Text="{Binding MasterVolumePercent}"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="MASTER VOLUME"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0"/>
                    </DockPanel>
                    <Slider Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Margin="0,10,0,0"/>
                    <CheckBox Content="Overlap sounds"
                              IsChecked="{Binding OverlapSounds}"
                              Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Top">
                    <Button Content="Refresh devices"
                            Style="{StaticResource ToolbarButton}"
                            Command="{Binding RefreshDeviceListCommand}"
                            Margin="0"/>
                    <Border Margin="0,10,0,0"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#FF1E2A22"
                            Visibility="{Binding HasVirtualCable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="VB-Cable detected"
                                   Foreground="{StaticResource OkBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>
                    <Border Margin="0,10,0,0"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#FF2A2218"
                            Visibility="{Binding HasVirtualCable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="No VB-Cable"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Microphone passthrough (Realtek / SteelSeries → CABLE Input) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="0,14,16,0">
                    <TextBlock Text="MICROPHONE (voice → Discord via cable)"
                               Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedMicrophoneDevice}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding EnableMicrophone}"/>
                    <DockPanel Margin="0,8,0,0">
                        <CheckBox Content="Send mic to Discord"
                                  IsChecked="{Binding EnableMicrophone}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MicVolumePercent}"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsEnabled="{Binding EnableMicrophone}"/>
                        <Slider Value="{Binding MicVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding EnableMicrophone}"/>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Pick Realtek or SteelSeries here. Discord stays on CABLE Output — your voice is mixed with soundboard pads."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pads grid -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Pads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PadCard}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <Border Width="10" Height="10"
                                                    CornerRadius="5"
                                                    Background="{Binding ColorIndex, Converter={StaticResource PadColor}}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <Button DockPanel.Dock="Right"
                                                    Content="✕"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontWeight="SemiBold"
                                                     FontSize="14"
                                                     Padding="0"/>
                                        </DockPanel>

                                        <Button Grid.Row="1"
                                                Margin="0,10"
                                                Cursor="Hand"
                                                Command="{Binding PlayCommand}"
                                                ToolTip="{Binding FilePath}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="PlayBd"
                                                            CornerRadius="10"
                                                            Background="{Binding ColorIndex, Converter={StaticResource PadColor}}"
                                                            Opacity="0.92">
                                                        <Grid>
                                                            <Ellipse Width="54" Height="54"
                                                                     Fill="#44000000"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="▶"
                                                                       FontSize="22"
                                                                       Foreground="#FF1A1208"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0,0,0"
                                                                       FontWeight="Bold"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="PlayBd" Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PlayBd" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <DockPanel Grid.Row="2" Margin="0,4,0,8" LastChildFill="True">
                                            <TextBlock Text="Vol"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding VolumePercent}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Width="36"
                                                       TextAlignment="Right"/>
                                            <Slider Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    SmallChange="0.01"
                                                    LargeChange="0.05"/>
                                        </DockPanel>

                                        <DockPanel Grid.Row="3">
                                            <Button DockPanel.Dock="Right"
                                                    Content="Clear"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding ClearHotkeyCommand}"/>
                                            <Button Content="{Binding HotkeyDisplay}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    Command="{Binding CaptureHotkeyCommand}"
                                                    Margin="0"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="Set a global keyboard shortcut"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasPads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            IsHitTestVisible="False">
                    <TextBlock Text="Drop MP3 / WAV / OGG files here"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="or use Add files / Folder"
                               FontSize="13"
                               Foreground="#FF667084"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="4,12,4,0">
            <Ellipse Width="8" Height="8"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Drop audio files here · hotkeys work globally"
                       Foreground="#FF667084"
                       FontSize="11"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
